# Copy to .env.local and fill in from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shared in the group chat; needed the first time someone signs up
INVITE_CODE=change-me

# The public address of the site, used in login emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Supabase > Project Settings > API keys > Secret key. Never share it.
SUPABASE_SECRET_KEY=sb_secret_...
